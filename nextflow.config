process {
    errorStrategy = 'retry'
    maxRetries = 2
    cpus = 4
    memory = { 16.GB * task.attempt }

    
}

    

manifest {
    nextflowVersion = '!>=26.10.0'
}

outputDir = params.outdir ?: 'results'
workflow.output.mode = 'copy'




executor {
    
    queueSize       = 30
    submitRateLimit = '30/2min'
}

docker.enabled  = true
wave.enabled    = true
// build the bcftools/samtools image for EXTRACT_FN_EVIDENCE from its conda directive
wave.strategy   = 'conda,container'
fusion.enabled  = true

// LLM agents (EXPLAIN_FN / EXPLAIN_FP, only run with --explain_fn / --explain_fp). The `pi` runner runs each
// agent in a container. The driver reads ANTHROPIC_API_KEY from the launch environment
// (on Seqera Platform: platform/pre-run.sh) and passes it to each agent task.
// Do not use secrets.ANTHROPIC_API_KEY here: on AWS Batch the Nextflow secrets
// provider only serves Batch tasks, and agent tasks fail with "AwsSecretsProvider
// requires the use of the AWS Batch executor".
//
// Agents do not inherit the `process` scope, so Platform's process.executor and
// process.queue never reach them, and they default to the `local` executor. On
// Platform that is the head job, which has no Docker, so the pi runner fails with
// "docker: command not found". Run them as AWS Batch jobs instead; the agent task
// connects back to the driver's RPC broker for the model call.
// See https://docs.seqera.io/nextflow/agent#configuration
agent {
    runner   = 'pi'
    executor = 'awsbatch'
    // Compute queue of the Batch Forge compute environment (TowerForge-65jW9ftzynV2CSKqbQX8BN).
    // Update this if the compute environment is recreated.
    queue    = 'TowerForge-65jW9ftzynV2CSKqbQX8BN-work'
    cpus     = 1
    memory   = 2.GB
}

profiles {
    local {
        process {
            queue = null
            executor = 'local'

            // 2. Override resource requirements globally for the stub run
            cpus     = 1
            memory   = 2.GB
            disk     = null // Prevents mounting large disk allocations locally

            // 3. Strip process-specific overrides so they don't look for 64GB or 64 CPUs
            withName: '.*' {
                cpus   = 1
                memory = 2.GB
            }

        }
        
        // Define your AWS credentials directly for this profile
        aws {
            accessKey = ''
            secretKey = ''
            // If you are using temporary AWS Academy or SSO credentials, uncomment below:
            // sessionToken = 'your_session_token_here'
        }


        docker {
            enabled = true
        }
        wave.enabled = false
        fusion.enabled = false

        // run agents on this machine's Docker, not AWS Batch
        agent.executor = 'local'
        agent.queue    = null
    }
}